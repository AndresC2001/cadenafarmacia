# Azure Container Apps Environment Variables
# Copy this file to .env and modify values for your Azure deployment

# ===========================================
# Frontend Configuration
# ===========================================
AUTH_SERVER_URL=https://auth-server.salmonsand-b8851faf.eastus.azurecontainerapps.io
API_GATEWAY_URL=https://api-gateway.salmonsand-b8851faf.eastus.azurecontainerapps.io/api

# ===========================================
# Auth Server Configuration
# ===========================================
OAUTH2_ISSUER=https://auth-server.salmonsand-b8851faf.eastus.azurecontainerapps.io
OAUTH2_REDIRECT_URI=https://api-gateway.salmonsand-b8851faf.eastus.azurecontainerapps.io/login/oauth2/code/gateway-client
ALLOWED_ORIGINS=https://frontend.salmonsand-b8851faf.eastus.azurecontainerapps.io

# ===========================================
# API Gateway Configuration
# ===========================================
JWK_SET_URI=https://auth-server.salmonsand-b8851faf.eastus.azurecontainerapps.io/oauth2/jwks
# Internal service URIs (use ACA internal URLs)
CATALOGO_SERVICE_URI=http://catalogo-service
INVENTARIO_SERVICE_URI=http://inventario-service
VENTAS_SERVICE_URI=http://ventas-service

# ===========================================
# Database Configuration (if using Azure Database)
# ===========================================
# AUTH_DB_URL=jdbc:postgresql://your-azure-postgres.postgres.database.azure.com:5432/auth_db
# AUTH_DB_USER=your_user
# AUTH_DB_PASSWORD=your_password
# CATALOGO_DB_URL=jdbc:postgresql://your-azure-postgres.postgres.database.azure.com:5432/catalogo_db
# INVENTARIO_DB_URL=jdbc:postgresql://your-azure-postgres.postgres.database.azure.com:5432/inventario_db
# VENTAS_DB_URL=jdbc:postgresql://your-azure-postgres.postgres.database.azure.com:5432/ventas_db
